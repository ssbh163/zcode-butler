{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/scripts/widget/widget-launch.mjs\"",
            "timeoutMs": 10000,
            "statusMessage": "码管家:拉起/唤醒悬浮窗(Windows)"
          },
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/scripts/status.mjs\" --hook",
            "timeoutMs": 8000,
            "statusMessage": "码管家:注入用量三环/Key 满额/未读资讯摘要"
          },
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/scripts/doc-intent.mjs\" --startup",
            "timeoutMs": 4000,
            "statusMessage": "码管家:检测待执行的会话归档意图"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/scripts/doc-intent.mjs\"",
            "timeoutMs": 4000,
            "statusMessage": "码管家:检测归档意图"
          }
        ]
      }
    ]
  }
}
